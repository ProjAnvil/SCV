# Smelt role config for the SCV eval — copy to .env and fill in.
#
# Simplest setup (DeepSeek): fill SMELT_API_KEY once below — the shared key and
# base_url apply to every role (agent / judge / challenger) via fallback.
# Per-role overrides (SMELT_<ROLE>_PROVIDER/_BASE_URL/_API_KEY/_MODEL) always win,
# e.g. run the agent on a cheap model and the judge on a stronger one:
#
#   SMELT_JUDGE_MODEL=deepseek-v4-pro
#
# Note: thinking mode is disabled in code (scv_eval/llm.py) — required for
# deepseek-v4-flash multi-turn loops.

# ---- Shared (fill once) ----
SMELT_LLM_PROVIDER=openai
SMELT_BASE_URL=https://api.deepseek.com
SMELT_API_KEY=sk-REPLACE-ME

# ---- Models per role ----
SMELT_AGENT_MODEL=deepseek-v4-flash       # the SCV skill agent under test
SMELT_JUDGE_MODEL=deepseek-v4-flash       # llm_judge + writing review
SMELT_CHALLENGER_MODEL=deepseek-v4-flash  # adversarial probes
